{
  "name": "instruct-agents",
  "version": "0.0.0",
  "description": "Composable structured agents",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-vendor-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.81.0",
    "@agentclientprotocol/codex-acp": "^1.13.0",
    "@agentclientprotocol/sdk": "^1.5.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "typescript": "^5.9.2",
    "vitest": "^4.0.0"
  }
}
